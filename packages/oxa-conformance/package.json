{
  "name": "oxa-conformance",
  "version": "0.1.0",
  "description": "Conformance test suite for OXA schema implementations",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./manifest.json": "./manifest.json",
