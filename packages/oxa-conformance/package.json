  "keywords": [
    "oxa",
    "conformance",
    "test-suite",
    "schema",
    "validation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxa-dev/oxa.git",
    "directory": "packages/oxa-conformance"
  }
}
